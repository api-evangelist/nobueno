              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this FCM device."
              }
            ]
          }
        },
        {
          "info": {
            "name": "devices_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/devices/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this FCM device."
              }
            ]
          }
        },
        {
          "info": {
            "name": "devices_delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/devices/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this FCM device."
              }
            ]
          }
        }
      ]
