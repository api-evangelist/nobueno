{
  "opencollection": "1.0.0",
  "info": {
    "name": "Jungle admin devices API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "devices_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/devices/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ]
          }
        },
        {
          "info": {
            "name": "devices_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/devices/"
          }
        },
        {
          "info": {
            "name": "devices_read",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/devices/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this FCM device."
              }
            ]
          }
        },
        {
          "info": {
            "name": "devices_update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
